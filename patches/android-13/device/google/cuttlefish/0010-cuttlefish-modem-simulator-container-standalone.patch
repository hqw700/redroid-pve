-// this file provide cuttlefish hooks
 namespace cuttlefish {
 namespace modem {
 
+static bool probe_interface_ipv4(const std::string& ifname, std::string* ip, int* prefix, std::string* gw) {
+  struct ifaddrs* ifaddr = nullptr;
+  if (getifaddrs(&ifaddr) == -1 || !ifaddr) {
+    return false;
+  }
+  bool found = false;
+  for (struct ifaddrs* ifa = ifaddr; ifa != nullptr; ifa = ifa->ifa_next) {
+    if (!ifa->ifa_addr || ifa->ifa_addr->sa_family != AF_INET) continue;
+    if (ifa->ifa_name && ifname == ifa->ifa_name) {
+      char ip_str[INET_ADDRSTRLEN] = {0};
+      auto* sa = reinterpret_cast<struct sockaddr_in*>(ifa->ifa_addr);
+      inet_ntop(AF_INET, &(sa->sin_addr), ip_str, INET_ADDRSTRLEN);
+      if (ip) *ip = ip_str;
+
+      if (prefix && ifa->ifa_netmask) {
+        auto* mask_sa = reinterpret_cast<struct sockaddr_in*>(ifa->ifa_netmask);
+        uint32_t mask = ntohl(mask_sa->sin_addr.s_addr);
+        int count = 0;
+        while (mask) {
+          count += (mask & 1);
+          mask >>= 1;
+        }
+        *prefix = count;
+      }
+      found = true;
+      break;
+    }
+  }
+  freeifaddrs(ifaddr);
+
+  if (found && gw) {
+    std::string gw_prop = android::base::GetProperty("ro.boot.radio_gw", "");
+    if (gw_prop.empty()) {
+      gw_prop = android::base::GetProperty("vendor.redroid.radio_gw", "");
+    }
+    if (!gw_prop.empty()) {
+      *gw = gw_prop;
+    } else {
+      FILE* fp = fopen("/proc/net/route", "r");
+      if (fp) {
+        char line[256];
+        while (fgets(line, sizeof(line), fp)) {
+          char dev[64];
+          unsigned long dest = 0, gate = 0;
+          if (sscanf(line, "%63s %lx %lx", dev, &dest, &gate) >= 3) {
+            if (ifname == dev && gate != 0) {
+              struct in_addr gaddr;
+              gaddr.s_addr = gate;
+              *gw = inet_ntoa(gaddr);
+              break;
+            }
+          }
+        }
+        fclose(fp);
+      }
+    }
+  }
+  return found;
+}
